# Prizm Configuration — prizm.yaml
#
# This is the primary configuration file for Prizm.
# It defines agents, channels, actions, and service settings.
# No dependency on OpenClaw — Prizm is its own system.
#
# Agent IDs become event namespace prefixes:
#   id: lumi → lumi.agent.started, lumi.tool.completed, etc.
#   If no ID is provided, auto-generated as prizm1, prizm2, etc.

prizm:
  # Instance name used by signed cross-Prizm messages.
  instance_id: "astraea-manager"
  # NATS bus URL. Empty = embedded NATS server.
  # For two-Prizm mode, point both environments at the Windows broker.
  nats_url: "nats://127.0.0.1:4222"
  # Data directory for SQLite databases and run artifacts.
  data_dir: "~/.prizm/data"
  # Workspace root for context injection (SOUL.md, AGENTS.md, USER.md, etc.)
  # Defaults to $HOME/.openclaw/workspace if empty.
  workspace: ""
  # Recursive roots for read/search/list tools. Prefer project/user roots over
  # full system roots like C:/Windows.
  read_roots:
    - "D:/"
    - "C:/Users/emaha"
  # Recursive roots for approval-gated writes. A parent grants its children.
  write_roots:
    - "D:/_projects_"
    - "D:/Projects"
  # Legacy alias for both read and write roots when read_roots/write_roots are omitted.
  allowed_paths: []
  # Gated-loop workflow definition (phases + gates). When set and loadable, it
  # overrides the built-in 7-phase DefaultConfig. Editable from the dashboard at
  # /workflow-editor.html. See examples/workflows/gated-loop.yaml.
  workflow_config: "examples/workflows/gated-loop.yaml"
  # Local Ollama base URL used by serve-mode Ollama agents.
  # Precedence: OLLAMA_BASE_URL env var overrides this; default localhost:11434.
  ollama_url: "http://localhost:11434"
  # Health server port. The HTTP API listens on port+1. `prizm status` and
  # `prizm watch` read this too, so server and clients stay in sync.
  # The serve --port flag overrides it.
  port: 8321
  # Token budget for workspace context injection (SOUL.md, AGENTS.md, ...).
  context_token_budget: 4000
  # Serve-mode LLM timeout in seconds. Local models often need more than 60s.
  llm_timeout_seconds: 1200
  # Log level: debug, info, warn, error
  log_level: "info"
  # Network interface for the HTTP API, health, and dashboard servers.
  # Default "127.0.0.1" (loopback only). Set to "0.0.0.0" to expose Prizm on
  # the network — this REQUIRES api.auth_token (or api.auth_token_env) below,
  # or the config is rejected at startup.
  bind_host: "127.0.0.1"
  # Built-in cron scheduler. Each job fires a NATS event on a schedule; the wake
  # handler runs the mapped payload.action. Full guide: docs/SCHEDULER.md
  scheduler:
    enabled: false
    jobs:
      # 2-hour status report: project state, recent runs, git activity.
      - name: "status-report"
        schedule: "0 */2 * * *"          # every 2 hours, on the hour
        event: "prizm.task.scheduled"
        payload:
          action: "status_report"
        enabled: true
      # Roblox Factory queue digest (needs factory_monitor.enabled).
      - name: "factory-status-digest"
        schedule: "*/15 * * * *"
        event: "prizm.task.scheduled"
        payload:
          action: "factory_status_digest"
        enabled: false

# HTTP API authentication and CORS. Optional when bound to loopback; required
# when prizm.bind_host is non-loopback.
api:
  # Static bearer token required on state-changing endpoints (POST/PUT/DELETE)
  # and the SSE event stream. Leave empty for loopback-only local use.
  auth_token: ""
  # Or read the token from an environment variable (takes priority when set),
  # keeping the secret out of tracked config.
  auth_token_env: ""        # e.g. "PRIZM_API_TOKEN"
  # CORS origin allowlist for a browser-based editor. Empty = same-origin only.
  # Avoid "*" except for trusted local development.
  allowed_origins: []

users:
  # Map channel-specific identities to one durable owner id. USER.md remains
  # human-readable context; this section is the machine-readable identity map.
  - id: "ema"
    display_name: "Ema"
    default: true
    aliases:
      discord:
        - "YOUR_DISCORD_USER_ID"
      cli:
        - "local-user"

bridge:
  # Set true after PRIZM_BRIDGE_SECRET is configured on both Prizm environments.
  enabled: false
  mode: "shared_nats"
  secret_env: "PRIZM_BRIDGE_SECRET"
  # Optional local fallback if the env var is unavailable. Keep real secrets out of git.
  secret: ""
  # Configurable leader for cross-Prizm threads. This can move between environments.
  leader_instance: "lumi-ceo"
  # Receiver-rated confidence gate. Below this, Prizm asks one clarification before accepting.
  confidence_threshold: 0.75
  max_clarification_rounds: 1
  allowed_subjects:
    - "prizm.cross.context_sync"
    - "prizm.cross.task_request"
    - "prizm.cross.status_request"
    - "prizm.cross.validation_request"
    - "prizm.cross.task_response"
    - "prizm.cross.task_accept"
    - "prizm.cross.task_reject"
    - "prizm.cross.clarification"
    - "prizm.cross.task_progress"
    - "prizm.cross.task_result"
    - "prizm.cross.task_cancel"
  target_profiles:
    - name: "generic"
      instance_id: "astraea-manager"
      adapter: "generic"
      capabilities: ["plan", "review", "report"]
    - name: "factory"
      instance_id: "astraea-manager"
      adapter: "factory"
      capabilities: ["roblox_factory", "validation", "report"]
    - name: "codex"
      instance_id: "astraea-manager"
      adapter: "codex"
      capabilities: ["code", "test", "review", "report"]
  factory:
    enabled: true
    root: "D:/_projects_/roblox-factory"
    project: "eggventura"
    project_path: "D:/Projects/Roblox/eggventura"
    approval_mode: "report_only"
    run_codex: false
    vision_review: "none"
    playtest_mode: "none"
    enable_ui_generation: false
    ui_generation_dry_run: true

# Self-patching scanner + fix loop (V50/V51). `prizm scan` finds ranked issues;
# `prizm scan --start` (or Discord "auto patch this bug") launches a fix task.
# Workers author the fix in an isolated git worktree, then validation profiles
# gate the result. Artifacts land under .prizm/data/autopatch/<task-id>/.
autopatch:
  enabled: false
  # "propose" = produce a patch artifact for review (never touches your repo).
  # "pr"      = open a GitHub pull request via the gh CLI (doctor preflights auth).
  mode: "propose"
  # Refuse to start when the repo has uncommitted changes (recommended).
  require_clean_worktree: true
  max_attempts: 2
  validation_profiles: ["go_test_all"]
  # Try workers in order: "codex" (Codex CLI) then "local_agent" (agent below).
  worker_order: ["codex", "local_agent"]
  # Agent ID used by the local_agent worker (e.g. an Ollama coder agent).
  local_agent: "forge"
  # Where isolated worktrees are created (relative to the repo root).
  worktree_root: ".prizm/worktrees"
  # PR base branch in "pr" mode. Empty = repository default branch.
  base_branch: ""

# External MCP (Model Context Protocol) tool servers (V49). Tools register as
# mcp_<name>_<tool> and run through the same policy engine as built-in tools.
# Probe a server before enabling: prizm mcp probe --command npx --args "-y,..."
mcp_servers: []
#  - name: "filesystem"
#    command: "npx"
#    args: ["-y", "@modelcontextprotocol/server-filesystem", "D:/_projects_"]
#    env: []
#    enabled: true

# MCP tools require approval by default (remote tools are higher-trust-risk).
# Set true to allow UNATTENDED execution of external MCP tools.
mcp_auto_approve: false

factory_monitor:
  enabled: false
  root: "D:/_projects_/roblox-factory"
  notify_channel_id: ""
  poll_seconds: 30
  stuck_after_minutes: 30

codex:
  # Uses the local Codex CLI login session. Run `codex login` before enabling.
  enabled: false
  # Empty = codex.cmd on Windows, codex elsewhere.
  executable: ""
  # Empty = Codex CLI default/profile model. Set only when you want to force a model.
  model: ""
  profile: ""
  # Empty = prizm.workspace, then current directory.
  workspace: ""
  sandbox: "workspace-write"
  approval_policy: "on-request"
  timeout_minutes: 30
  max_concurrency: 1
  capture_diff: true
  extra_args: []

# Claude Code sub-agent reviewer for the gated loop. When enabled, it runs the
# `claude` CLI in print mode to review paused FEEDBACK_PRE/FEEDBACK_POST gates
# whose approvers/required_reviewers include `reviewer_name`. Read-only by
# default (no edits). Run `claude` once interactively to authenticate first.
# To use it, add the reviewer name to a gate in your workflow config, e.g.
#   FEEDBACK_POST gate: { type: review_pass, required_reviewers: [claude] }
# or keep a human too: required_reviewers: [ema, claude].
# Claude Code CLI integration. Used in two ways:
#   1. Reviewer at FEEDBACK gates (reviewer_name / allowed_tools below).
#   2. Orchestrator BRAIN for the gated loop — define an agent with
#      provider: claude_code (see agents:) and point a project at it with
#      project.orchestrator. The provider shells out to `claude -p` with tools
#      disabled, so Prizm still owns tool execution, gates, and policy.
# Auth comes from the installed `claude` subscription session — no API key.
# executable / timeout_minutes here are reused by the orchestrator provider.
claude_code:
  enabled: false
  executable: ""          # empty = resolve claude from PATH
  model: ""               # empty = CLI default; e.g. claude-opus-4-8
  reviewer_name: "claude" # gate approver/reviewer name this fulfills
  timeout_minutes: 10
  allowed_tools: ""       # empty = read-only default (Read/Grep/Glob + git reads)
  extra_args: []

# Projects the gated loop can work on. Replaces hardcoded repo paths so projects
# are assignable/dynamic. Start a loop with:
#   prizm workflow start --project <id> --prompt "..."
# or POST /api/v1/workflows/start {"project":"<id>","prompt":"..."}.
projects:
  - id: example
    repo_path: "D:/_projects_/example"   # absolute path to the project's git repo
    state_file: "PROJECT_STATE.md"        # optional; relative to repo_path
    default_branch: "main"                 # protected branch (writes blocked here)
    channel: ""                            # messaging channel for results/feedback
    workflow_config: ""                    # optional per-project workflow override
    token_budget: 2000000                   # optional per-project run token cap; -1 = unlimited, 0 = workflow/default
    orchestrator: ""                       # optional agent ID to drive this project's
                                           # gated loop (e.g. "claude_code"); empty = primary agent
    worktree_isolation: false              # V56: run each gated loop in its own git worktree
                                           # (<repo>/.prizm/worktrees/<run-id>, branch prizm/<run-id>)
                                           # so parallel runs can't collide; main worktree untouched
    default: true                          # used when no --project is given

agents:
  - id: astraea
    role: orchestrator
    provider: ollama
    model: "llama3.2"
    primary: true
    context:
      - soul
      - agents
      - user
    capabilities:
      - plan
      - route
      - review
      - validate
      - report
    state_actions:
      manager-room:
        inject: "Act as the Windows-side Prizm manager. Prefer explicit status, bridge health, and Factory validation handoff."
      build-room:
        inject: "Focus on Roblox Factory coordination. Keep work report-only unless implementation is explicitly approved."
    # Keep Discord bot-to-bot listening disabled. Cross-Prizm agents communicate over NATS.
    listen_to_agents: []
    # V22: Subscribe to other agents' task events
    # subscriptions:
    #   - "mango.task.completed"  # Receive Mango's results

  - id: forge
    role: coder
    provider: ollama
    model: "llama3.2"
    context:
      - agents
    capabilities:
      - code
      - test
      - report
    # V22: Subscribe to delegated tasks
    # subscriptions:
    #   - "mango.task.created"  # Receive tasks from Lumi

  # Optional Claude Code subscription brain. Drives the gated loop via the local
  # `claude` CLI (no API key — uses your subscription). Requires claude_code.enabled
  # above and a logged-in `claude`. Select it per project with project.orchestrator:
  # claude_code. The model below is BOTH the registry selector and the --model passed
  # to the CLI, so set a real Claude model id (not empty).
  # - id: claude_code
  #   role: orchestrator
  #   provider: claude_code
  #   model: "claude-opus-4-8"
  #   capabilities:
  #     - plan
  #     - route
  #     - review
  #     - report

  # Optional API-backed model. Requires OPENAI_API_KEY and API billing.
  # ChatGPT web subscriptions and API billing are separate.
  # - id: openai-reviewer
  #   role: reviewer
  #   provider: openai_responses
  #   model: "gpt-5.1"
  #   context:
  #     - agents
  #   capabilities:
  #     - review
  #     - summarize

  # Optional single-shot invocation agent for external addons (e.g. Clippy,
  # an OBS stream-clip-detection addon — see docs/V59-AGENT-INVOCATION-API-DESIGN.md).
  # invocable_via_api opts this agent into POST /api/v1/agents/clippy/invoke,
  # a minimal HTTP contract for out-of-process callers that don't import
  # Prizm's internal Go packages. Requires api.auth_token or
  # api.auth_token_env to be set — see the `api:` block above. No agent is
  # invocable via API by default; this must be explicitly enabled per agent.
  #
  # By default each invoke is single-shot (no memory). To hold a multi-turn
  # conversation, send a stable "conversation_id" on each request (e.g. the
  # Discord channel id); prior turns are then threaded into the prompt and the
  # reply is remembered. The conversation stays open until the user says
  # "stop"/"new topic" (auto-detected), until you send "reset": true, or until
  # sessions.invoke_idle_timeout_hours of inactivity. Example request body:
  #   {"prompt": "...", "conversation_id": "1491622581348864162"}
  # - id: clippy
  #   role: stream-clip-judge
  #   provider: anthropic
  #   model: "claude-3-5-haiku-20241022"
  #   invocable_via_api: true
  #   conversation_postfix: >
  #     You are Clippy, judging live-stream moments for clip-worthiness from
  #     a compact signal summary (chat velocity, audio spike, a local vision
  #     model's description). Respond ONLY with strict JSON: {"clip_worthy":
  #     bool, "confidence": 0-1, "title": string, "reason": string}. Be
  #     decisive and terse. Most spikes are noise — only flag genuinely
  #     reactive, funny, skillful, or dramatic moments.

# External channels are optional. Keep the default example model-free and
# uncomment this block only after setting DISCORD_BOT_TOKEN.
channels: []
#  - type: discord
#    token: "${DISCORD_BOT_TOKEN}"
#    channels:
#      - "general"
#      - "dev"

channel_roles:
  - id: "general"
    role: "manager-room"
    tools: "read-only"
    personality: "direct"
    context: "Coordination room for cross-Prizm status, task triage, and manager-level decisions."
  - id: "dev"
    role: "build-room"
    tools: "all"
    personality: "terse"
    context: "Roblox Factory build and validation room. Prefer concrete task handoff, smoke checks, and artifact paths."

actions:
  # Save agent output to memory
  - trigger: "*.agent.output"
    action: "remembrance.gate.extract"
    enabled: true

  # Track token costs for every tool completion
  - trigger: "*.tool.completed"
    action: "prizm.cost.track"
    enabled: true

  # Track LLM costs
  - trigger: "*.llm.completed"
    action: "prizm.cost.track"
    enabled: true

  # Send approval requests to Discord
  - trigger: "*.approval.requested"
    action: "adapter.discord.notify"
    enabled: false  # enable with the Discord channel above

sessions:
  # How long before an idle session resets (minutes)
  idle_timeout_minutes: 30
  # Hour (0-23) when sessions reset daily
  daily_reset_hour: 4
  # Maximum messages in a session before compaction
  max_context_messages: 100
  # Persistent sessions resume after restart and idle timeout.
  persistence: true
  resume_after_idle: true
  # Compaction strategy: "truncate" or "summarize". Both preserve archived rows
  # when keep_archived_messages is true.
  compaction_strategy: "summarize"
  keep_archived_messages: true
  # Default continuity is one recent conversation per owner+agent, even across
  # Discord channels. Use "channel_user" for historical per-channel behavior.
  continuity_scope: "owner_agent"
  # Current-week local recall starts Monday 00:00 in the configured timezone.
  # Set recall_window_mode to "rolling_days" to use short_term_window_days.
  recall_window_mode: "calendar_week"
  recall_timezone: "Local"
  # Local recall window and exact transcript cap. Remembrance is lower priority
  # long-term semantic memory, not active-session continuity.
  short_term_window_days: 7
  verbatim_recent_messages: 40
  # Safety net for stateful Agent Invocation API conversations (invoke calls that
  # carry a conversation_id — see the invocable agent above). A conversation stays
  # open across calls until an explicit stop/switch, or until it has been idle this
  # many hours. 0 disables the safety net (open until explicitly reset).
  invoke_idle_timeout_hours: 36

remembrance:
  enabled: false
  url: "http://localhost:18790"
  timeout_seconds: 60
